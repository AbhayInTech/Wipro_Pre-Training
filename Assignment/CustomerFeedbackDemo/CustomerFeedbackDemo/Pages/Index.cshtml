@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Customer Feedback Portal</h1>
    <p>Submit your feedback on our products and services.</p>
    <p><a asp-page="Feedback" class="btn btn-primary">Submit Feedback</a></p>
    <p><a asp-page="ViewFeedback" class="btn btn-secondary">View Submitted Feedback</a></p>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
